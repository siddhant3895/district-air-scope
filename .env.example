# Frontend Environment Configuration (.env.example)
# Defaults to VITE_DATA_MODE=live to query the FastAPI backend (/api via Vite proxy or VITE_API_BASE_URL).
# Silent fallback to mock data is disabled by default (VITE_ALLOW_MOCK_FALLBACK=false)
# and is always blocked in production builds so missing data is never masked by mock values.
VITE_DATA_MODE=live
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ALLOW_MOCK_FALLBACK=false
