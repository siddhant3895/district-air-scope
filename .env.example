# Frontend & SSR Environment Configuration (.env.example)
#
# 1. Data Mode
# Defaults to "live" so the frontend queries the FastAPI backend.
# Set VITE_DATA_MODE=mock only for offline design preview.
VITE_DATA_MODE=live

# 2. Browser / Client API Base URL (VITE_API_BASE_URL)
# - In local development with Vite proxy or single-origin reverse proxy: "/api"
# - In split-origin staging/production deployments: "https://api.your-domain.example/api"
VITE_API_BASE_URL=/api

# 3. Server-Side Rendering (SSR) Backend Origin (VITE_BACKEND_ORIGIN)
# Required when VITE_API_BASE_URL is a relative path ("/api"):
# TanStack Start route loaders executing on the server (SSR) resolve relative "/api"
# requests against VITE_BACKEND_ORIGIN (e.g., "http://localhost:8000" locally or
# "http://backend-api:8000" inside Docker Compose), and Vite dev server proxies "/api" to it.
VITE_BACKEND_ORIGIN=http://localhost:8000

# 4. Mock Fallback Guard
# Silent fallback to mock data is disabled by default (VITE_ALLOW_MOCK_FALLBACK=false)
# and is permanently blocked in production builds so missing data is never masked by mock values.
VITE_ALLOW_MOCK_FALLBACK=false
