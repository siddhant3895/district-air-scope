# DistrictWatch Backend Configuration (.env.example)
# Copy this file to .env and populate credentials locally when ready for live ingestion.
# If keys are omitted, the backend starts cleanly and returns truthful "unavailable"
# snapshots (aqi: null, stations: 0, coverage: 0) without fabricating live data.

# 1. XKDR Forum India Air Quality Database API Key (Recommended CPCB CAAQM + US Embassy harmonized feed)
# Register for a free personal key at https://airquality.xkdr.org/signup (no rate limits, no row caps).
# Public demo key documented at https://airquality.xkdr.org/ (capped at 10,000 rows/query, 2024 data).
# Licensed under CC BY 4.0 (attribution: "India Air Quality Database, XKDR Forum").
XKDR_API_KEY=
XKDR_API_BASE_URL=https://airquality.xkdr.org

# 2. OpenAQ API v3 Key (Real-time verified concentration feed & 30-day hourly history)
# Register at https://explore.openaq.org/register
OPENAQ_API_KEY=

# 3. Open Government Data (OGD) Platform India — CPCB Real-Time AQI API Key (Optional)
# Resource ID: 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
# NOTE: Standard OGD records omit physical units (pollutant_unit="NA"). Unitless records
# are logged in raw_station_observations for auditability and rejected safely from AQI calculation.
DATA_GOV_IN_API_KEY=

# 4. Database Connection URL (Defaults to local SQLite file in backend/)
DATABASE_URL=sqlite:///./districtwatch.db

# 5. Freshness, Incremental Sync & Rate-Limit Settings
STALE_THRESHOLD_HOURS=6.0
INITIAL_BACKFILL_DAYS=30
INCREMENTAL_SYNC_OVERLAP_HOURS=3
MIN_REQUEST_INTERVAL_SEC=1.0
MAX_HTTP_RETRIES=3

# 6. CORS Origins (Comma-separated frontend origins allowed to query the API)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
